        <archunit-junit5-engine.version>1.3.0</archunit-junit5-engine.version>
        <spring-cloud-starter-netflix-eureka-client.version>5.0.0</spring-cloud-starter-netflix-eureka-client.version>
        <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
        
        <pdfbox.version>2.0.24</pdfbox.version>
        <poi.version>5.2.2</poi.version>
        <javafaker.version>1.0.2</javafaker.version>
        <reflections.version>0.9.12</reflections.version>
        <random-beans.version>3.9.0</random-beans.version>
        <modelmapper.version>3.2.0</modelmapper.version>
        <classgraph.version>4.8.165</classgraph.version>
        <springdoc.version>2.5.0</springdoc.version>
        <archunit.version>1.3.0</archunit.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        
        <jackson.version>2.20</jackson.version>
        <spring-web.version>7.0.2</spring-web.version>
        <commons-imaging-alpha.version>1.0-alpha3</commons-imaging-alpha.version>
        <common-lib.version>0.0.0-develop</common-lib.version>
    </properties>

    <dependencyManagement>
        <dependencies>
                <dependency>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
