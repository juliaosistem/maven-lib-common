    <modelVersion>4.0.0</modelVersion>
    <groupId>common-lib</groupId>
    <artifactId>common-lib</artifactId>
    <version>0.0.0-develop</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <spring-boot.version>3.5.4</spring-boot.version>
        <spring-cloud.version>4.3.0</spring-cloud.version>
        <spring-cloud-dependencies.version>2025.0.0</spring-cloud-dependencies.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.36</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <kotlin.version>2.2.0</kotlin.version>
        <postgres.version>42.2.27</postgres.version>
        <jacoco.version>0.8.10</jacoco.version>
        <jakarta.validation-api.version>3.1.1</jakarta.validation-api.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit-junit5-engine.version>1.3.0</archunit-junit5-engine.version>
        <spring-cloud-starter-netflix-eureka-client.version>4.3.0</spring-cloud-starter-netflix-eureka-client.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
